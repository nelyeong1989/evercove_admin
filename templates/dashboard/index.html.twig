{% extends 'base.html.twig' %}

{% block title %}Dashboard — Evercove Admin{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
  body { background-color: #f4f6f8; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
  .dashboard-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
  .dashboard-header h2 { color: #274d3a; font-weight: 700; margin-bottom: 0.25rem; }
  
  .kpi-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    border: 1px solid rgba(188, 148, 86, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .kpi-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    background: #274d3a;
    color: #f2e1d1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }
  .kpi-title { font-size: 0.85rem; color: #6c757d; font-weight: 600; text-transform: uppercase; }
  .kpi-value { font-size: 1.75rem; font-weight: 700; color: #274d3a; margin-bottom: 0; }

  .quick-nav .btn { font-weight: 600; padding: 0.75rem 1rem; border-radius: 8px; }
  .btn-evercove { background: #274d3a; color: #ffffff; border: none; }
  .btn-evercove:hover { background: #1e3c2d; color: #ffffff; }
  .btn-gold { background: #bc9456; color: #ffffff; border: none; }
  .btn-gold:hover { background: #a17d45; color: #ffffff; }

  .table-box { background: #ffffff; border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(188, 148, 86, 0.2); box-shadow: 0 4px 15px rgba(0,0,0,0.04); }
  table th { background: #274d3a; color: #f2e1d1; font-size: 0.75rem; text-transform: uppercase; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <h2>Executive Dashboard</h2>
      <p class="text-muted mb-0">Overview of Evercove operations, inventory, and revenue metrics.</p>
    </div>
    <div class="quick-nav d-flex gap-2">
      <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary">Categories</a>
      <a href="{{ path('app_room_index') }}" class="btn btn-evercove">Rooms</a>
      <a href="{{ path('app_reservation_index') }}" class="btn btn-gold">Reservations</a>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-title">Gross Revenue</div>
          <div class="kpi-value">₱{{ totalRevenue|number_format(2) }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-title">Total Rooms</div>
          <div class="kpi-value">{{ totalRooms }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-door-open"></i></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-title">Total Bookings</div>
          <div class="kpi-value">{{ totalReservations }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-calendar-check"></i></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="kpi-card">
        <div>
          <div class="kpi-title">Users</div>
          <div class="kpi-value">{{ totalUsers }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-people"></i></div>
      </div>
    </div>
  </div>

  <div class="table-box">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0" style="color: #274d3a;">Recent Bookings</h5>
      <a href="{{ path('app_reservation_index') }}" class="text-decoration-none fw-semibold" style="color: #bc9456; font-size: 0.9rem;">View All →</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Booking ID</th>
            <th>Guest</th>
            <th>Room</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Total Price</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
        {% for reservation in recentReservations %}
          <tr>
            <td><strong>#{{ reservation.id }}</strong></td>
            <td>{{ reservation.user.username }}</td>
            <td><span class="badge" style="background-color: #f2e1d1; color: #274d3a;">{{ reservation.room.name }}</span></td>
            <td>{{ reservation.checkIn ? reservation.checkIn|date('Y-m-d') : '' }}</td>
            <td>{{ reservation.checkOut ? reservation.checkOut|date('Y-m-d') : '' }}</td>
            <td><strong>₱{{ reservation.totalPrice|number_format(2) }}</strong></td>
            <td>
              {% if reservation.status == 'Confirmed' %}
                <span class="badge bg-success">Confirmed</span>
              {% elseif reservation.status == 'Pending' %}
                <span class="badge bg-warning text-dark">Pending</span>
              {% else %}
                <span class="badge bg-secondary">{{ reservation.status }}</span>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center text-muted py-4">No recent booking records found.</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}