{% extends 'base.html.twig' %}

{% block title %}Dashboard — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .dashboard-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .dashboard-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .dashboard-header h2 { color: #274d3a; font-weight: 700; margin-bottom: 0.25rem; }

  .kpi-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 1.35rem 1.4rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(188, 148, 86, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 100%;
    min-width: 0;
  }
  .kpi-info {
    min-width: 0;
    flex: 1;
  }
  .kpi-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    background: #274d3a;
    color: #f2e1d1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }
  .kpi-title {
    font-size: 0.78rem;
    color: #6c757d;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    white-space: nowrap;
    margin-bottom: 0.3rem;
  }
  .kpi-value {
    font-size: clamp(1.25rem, 1.5vw, 1.6rem);
    font-weight: 700;
    color: #274d3a;
    line-height: 1.2;
    white-space: nowrap;
    margin-bottom: 0;
  }

  .quick-nav .btn { font-weight: 600; padding: 0.65rem 1rem; border-radius: 8px; }
  .btn-evercove { background: #274d3a; color: #ffffff; border: none; }
  .btn-evercove:hover { background: #1e3c2d; color: #ffffff; }
  .btn-gold { background: #bc9456; color: #ffffff; border: none; }
  .btn-gold:hover { background: #a17d45; color: #ffffff; }

  .table-box {
    background: #ffffff;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid rgba(188, 148, 86, 0.2);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  .status-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }
  .status-pill {
    border: 1px solid rgba(39, 77, 58, 0.22);
    background: #ffffff;
    color: #274d3a;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status-pill:hover {
    background: #f2e1d1;
    border-color: #bc9456;
  }
  .status-pill.active {
    background: #274d3a;
    color: #f2e1d1;
    border-color: #274d3a;
  }
  .status-pill .pill-count {
    background: rgba(39, 77, 58, 0.1);
    color: #274d3a;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .status-pill.active .pill-count {
    background: rgba(242, 225, 209, 0.2);
    color: #f2e1d1;
  }

  table th {
    background: #274d3a;
    color: #f2e1d1;
    font-size: 0.75rem;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 0.85rem 1rem;
  }
  table td { padding: 0.95rem 1rem; }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <h2>Executive Dashboard</h2>
      <p class="text-muted mb-0">Overview of Evercove operations, inventory, and revenue metrics.</p>
    </div>
    <div class="quick-nav d-flex flex-wrap gap-2">
      <a href="{{ path('app_category_index') }}" class="btn btn-outline-secondary">Categories</a>
      <a href="{{ path('app_room_index') }}" class="btn btn-evercove">Rooms</a>
      <a href="{{ path('app_reservation_index') }}" class="btn btn-gold">Reservations</a>
    </div>
  </div>

  <div class="row g-3 g-lg-4 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-info">
          <div class="kpi-title">Gross Revenue</div>
          <div class="kpi-value">&#8369;{{ totalRevenue|number_format(2) }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-info">
          <div class="kpi-title">Total Rooms</div>
          <div class="kpi-value">{{ totalRooms }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-door-open"></i></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-info">
          <div class="kpi-title">Total Bookings</div>
          <div class="kpi-value">{{ totalReservations }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-calendar-check"></i></div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-info">
          <div class="kpi-title">Users</div>
          <div class="kpi-value">{{ totalUsers }}</div>
        </div>
        <div class="kpi-icon"><i class="bi bi-people"></i></div>
      </div>
    </div>
  </div>

  <div class="table-box">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h5 class="fw-bold mb-0" style="color: #274d3a;">Recent Bookings</h5>
      <a href="{{ path('app_reservation_index') }}" class="text-decoration-none fw-semibold" style="color: #bc9456; font-size: 0.9rem;">View All &rarr;</a>
    </div>

    <div class="status-filter-bar" id="dashboard-status-filters">
      {% for statusLabel in ['All', 'Confirmed', 'Pending', 'Cancelled', 'Completed'] %}
        <button
          type="button"
          class="status-pill {{ loop.first ? 'active' : '' }}"
          data-filter="{{ statusLabel }}"
        >
          <span>{{ statusLabel }}</span>
          <span class="pill-count">{{ statusCounts[statusLabel]|default(0) }}</span>
        </button>
      {% endfor %}
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th style="border-top-left-radius: 6px;">Booking ID</th>
            <th>Staff Account</th>
            <th>Room</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Total Price</th>
            <th style="border-top-right-radius: 6px;">Status</th>
          </tr>
        </thead>
        <tbody>
        {% for reservation in recentReservations %}
          <tr class="dashboard-booking-row" data-status="{{ reservation.status }}">
            <td><strong>#{{ reservation.id }}</strong></td>
            <td class="text-nowrap">{{ reservation.user.username }}</td>
            <td class="text-nowrap"><span class="badge" style="background-color: #f2e1d1; color: #274d3a;">{{ reservation.room.name }}</span></td>
            <td class="text-nowrap">{{ reservation.checkIn ? reservation.checkIn|date('Y-m-d') : '' }}</td>
            <td class="text-nowrap">{{ reservation.checkOut ? reservation.checkOut|date('Y-m-d') : '' }}</td>
            <td class="text-nowrap"><strong>&#8369;{{ reservation.totalPrice|number_format(2) }}</strong></td>
            <td>
              {% if reservation.status == 'Confirmed' %}
                <span class="badge bg-success">Confirmed</span>
              {% elseif reservation.status == 'Pending' %}
                <span class="badge bg-warning text-dark">Pending</span>
              {% elseif reservation.status == 'Cancelled' %}
                <span class="badge bg-danger">Cancelled</span>
              {% elseif reservation.status == 'Completed' %}
                <span class="badge bg-info text-dark">Completed</span>
              {% else %}
                <span class="badge bg-secondary">{{ reservation.status }}</span>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center text-muted py-4">No recent booking records found.</td>
          </tr>
        {% endfor %}
        {% if recentReservations is not empty %}
          <tr id="dashboard-empty-filter" style="display: none;">
            <td colspan="7" class="text-center text-muted py-4">No bookings found for this status.</td>
          </tr>
        {% endif %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (function () {
    function initDashboardStatusFilter() {
      const filterBar = document.getElementById('dashboard-status-filters');
      if (!filterBar || filterBar.dataset.bound === '1') return;
      filterBar.dataset.bound = '1';

      const pills = filterBar.querySelectorAll('.status-pill');
      const rows = document.querySelectorAll('.dashboard-booking-row');
      const emptyRow = document.getElementById('dashboard-empty-filter');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const selectedStatus = pill.getAttribute('data-filter');

          pills.forEach((btn) => btn.classList.remove('active'));
          pill.classList.add('active');

          let visibleCount = 0;
          rows.forEach((row) => {
            const match = selectedStatus === 'All' || row.getAttribute('data-status') === selectedStatus;
            row.style.display = match ? '' : 'none';
            if (match) visibleCount++;
          });

          if (emptyRow) {
            emptyRow.style.display = visibleCount === 0 ? '' : 'none';
            if (visibleCount === 0) {
              emptyRow.querySelector('td').textContent = `No ${selectedStatus.toLowerCase()} bookings found.`;
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDashboardStatusFilter);
    } else {
      initDashboardStatusFilter();
    }
    document.addEventListener('turbo:load', initDashboardStatusFilter);
  })();
</script>
{% endblock %}