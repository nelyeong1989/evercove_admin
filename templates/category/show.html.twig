{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .detail-wrapper { max-width: 680px; margin: 0 auto; }
  .detail-table th { width: 32%; color: #274d3a; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; background: transparent; }
  .detail-table td { color: #2d3748; font-size: 0.95rem; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="detail-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">{{ category.name }}</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Category details and description.</p>
      </div>
      <a href="{{ path('app_category_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      <div class="table-responsive">
        <table class="table detail-table align-middle mb-0">
          <tbody>
            <tr>
              <th>Category ID</th>
              <td><strong>#{{ category.id }}</strong></td>
            </tr>
            <tr>
              <th>Name</th>
              <td><strong style="color: #274d3a;">{{ category.name }}</strong></td>
            </tr>
            <tr>
              <th>Description</th>
              <td>{{ category.description ?? 'No description provided.' }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-success">
          <i class="bi bi-pencil-square"></i> Edit Category
        </a>

        {{ include('category/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}