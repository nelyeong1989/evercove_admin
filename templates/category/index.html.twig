{% extends 'base.html.twig' %}

{% block title %}Room Categories — Evercove Admin{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .page-header h2 { color: #274d3a; font-weight: 700; font-size: 1.4rem; }
  .btn-gold {
    background: #bc9456; color: #fff; font-weight: 700; border: none;
    padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.85rem;
  }
  .btn-gold:hover { background: #a17d45; color: #fff; }
  .table-box {
    background: #fff; border: 1px solid rgba(188, 148, 86, 0.25);
    border-radius: 8px; padding: 1.4rem;
  }
  table th { background: #274d3a; color: #f2e1d1; font-size: 0.75rem; text-transform: uppercase; }
</style>
{% endblock %}

{% block body %}
  {# Flash Alert Banners matching midterm style #}
  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: #305d4b; color: #ffffff; border: none; font-size: 0.88rem;">
      <strong>Success!</strong> {{ message }}
      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}

  <div class="page-header">
    <div>
      <h2>Room Categories</h2>
      <p class="text-muted mb-0" style="font-size: 0.85rem;">Manage room types, suites, and cabin classifications.</p>
    </div>
    <button type="button" class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
      + Add Category
    </button>
  </div>

  <div class="table-box">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>Category Name</th>
          <th>Description</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
      {% for category in categories %}
        <tr>
          <td><strong>#{{ category.id }}</strong></td>
          <td><strong>{{ category.name }}</strong></td>
          <td>{{ category.description ?? 'No description provided.' }}</td>
          <td class="text-end">
            <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm btn-outline-secondary">View</a>
            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-success">Edit</a>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="4" class="text-center text-muted py-4">No categories found. Click "+ Add Category" to create one.</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Create Category Bootstrap Modal -->
  <div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header" style="background: #274d3a; color: #f2e1d1;">
          <h5 class="modal-title" id="createCategoryModalLabel">New Room Category</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        {{ form_start(form) }}
          <div class="modal-body">
            {{ form_widget(form) }}
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-gold btn-sm">Save Category</button>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}