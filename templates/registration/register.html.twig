{% extends 'base.html.twig' %}

{% block title %}Create Staff Account — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .form-wrapper { max-width: 560px; margin: 0 auto; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Create Staff Account</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Provision a new Front Desk Staff or Admin login.</p>
      </div>
      <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to Accounts</a>
    </div>

    <div class="evercove-card">
      {{ form_start(registrationForm) }}
        <div class="evercove-form-fields">
          {{ form_row(registrationForm.fullName) }}
          {{ form_row(registrationForm.username) }}
          {{ form_row(registrationForm.email) }}
          {{ form_row(registrationForm.role) }}
          {{ form_row(registrationForm.plainPassword) }}
          {{ form_row(registrationForm.isActive) }}
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
          <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">Cancel</a>
          <button type="submit" class="btn btn-gold px-4">Create Account</button>
        </div>
      {{ form_end(registrationForm) }}
    </div>
  </div>
</div>
{% endblock %}