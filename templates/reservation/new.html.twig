{% extends 'base.html.twig' %}

{% block title %}New Reservation — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .form-wrapper { max-width: 600px; margin: 0 auto; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Create Reservation</h2>
      <a href="{{ path('app_reservation_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      {{ include('reservation/_form.html.twig') }}
    </div>
  </div>
</div>
{% endblock %}