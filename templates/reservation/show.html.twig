{% extends 'base.html.twig' %}

{% block title %}Reservation #{{ reservation.id }} — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .detail-wrapper { max-width: 720px; margin: 0 auto; }
  .detail-table th { width: 34%; color: #274d3a; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; background: transparent; }
  .detail-table td { color: #2d3748; font-size: 0.95rem; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="detail-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Reservation #{{ reservation.id }}</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Booking summary and record ownership details.</p>
      </div>
      <a href="{{ path('app_reservation_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      <div class="table-responsive">
        <table class="table detail-table align-middle mb-0">
          <tbody>
            <tr>
              <th>Booking ID</th>
              <td><strong>#{{ reservation.id }}</strong></td>
            </tr>
            <tr>
              <th>Guest Account</th>
              <td><strong>{{ reservation.user.username }}</strong> ({{ reservation.user.email }})</td>
            </tr>
            <tr>
              <th>Assigned Room</th>
              <td>
                <span class="badge" style="background-color: #f2e1d1; color: #274d3a; font-size: 0.85rem;">
                  {{ reservation.room.name }}
                </span>
              </td>
            </tr>
            <tr>
              <th>Check-In Date</th>
              <td>{{ reservation.checkIn ? reservation.checkIn|date('M d, Y') : '—' }}</td>
            </tr>
            <tr>
              <th>Check-Out Date</th>
              <td>{{ reservation.checkOut ? reservation.checkOut|date('M d, Y') : '—' }}</td>
            </tr>
            <tr>
              <th>Total Amount</th>
              <td><strong style="color: #274d3a; font-size: 1.05rem;">₱{{ reservation.totalPrice|number_format(2) }}</strong></td>
            </tr>
            <tr>
              <th>Status</th>
              <td>
                {% if reservation.status == 'Confirmed' %}
                  <span class="badge bg-success">Confirmed</span>
                {% elseif reservation.status == 'Pending' %}
                  <span class="badge bg-warning text-dark">Pending</span>
                {% elseif reservation.status == 'Cancelled' %}
                  <span class="badge bg-danger">Cancelled</span>
                {% else %}
                  <span class="badge bg-secondary">{{ reservation.status }}</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <th>Booked By (Staff)</th>
              <td>
                {% if reservation.createdBy %}
                  <span class="text-muted"><i class="bi bi-person-badge"></i> {{ reservation.createdBy.username }}</span>
                {% else %}
                  <span class="text-muted">System</span>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <div class="d-flex gap-2">
          {% if is_granted('RECORD_EDIT', reservation) %}
            <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn btn-sm btn-outline-success">
              <i class="bi bi-pencil-square"></i> Edit Booking
            </a>
          {% else %}
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="You can only edit bookings you created.">
              <i class="bi bi-lock-fill"></i> Locked (Not Owner)
            </button>
          {% endif %}
        </div>

        {{ include('reservation/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}