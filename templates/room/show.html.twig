{% extends 'base.html.twig' %}

{% block title %}{{ room.name }} — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .detail-wrapper { max-width: 720px; margin: 0 auto; }
  .detail-table th { width: 34%; color: #274d3a; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; background: transparent; }
  .detail-table td { color: #2d3748; font-size: 0.95rem; }
  .room-preview-img {
    width: 100%;
    max-height: 280px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(188, 148, 86, 0.35);
  }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="detail-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">{{ room.name }}</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Room specifications, nightly rate, and availability.</p>
      </div>
      <a href="{{ path('app_room_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      {% if room.imagePath %}
        <div class="mb-4">
          <img src="{{ asset(room.imagePath|trim('/')) }}" alt="{{ room.name }}" class="room-preview-img">
        </div>
      {% endif %}

      <div class="table-responsive">
        <table class="table detail-table align-middle mb-0">
          <tbody>
            <tr>
              <th>Room ID</th>
              <td><strong>#{{ room.id }}</strong></td>
            </tr>
            <tr>
              <th>Room Name</th>
              <td><strong style="color: #274d3a;">{{ room.name }}</strong></td>
            </tr>
            <tr>
              <th>Category</th>
              <td>
                <span class="badge" style="background-color: #f2e1d1; color: #274d3a; font-size: 0.85rem;">
                  {{ room.category ? room.category.name : 'Uncategorized' }}
                </span>
              </td>
            </tr>
            <tr>
              <th>Price / Night</th>
              <td><strong style="color: #274d3a; font-size: 1.05rem;">₱{{ room.pricePerNight|number_format(2) }}</strong></td>
            </tr>
            <tr>
              <th>Guest Capacity</th>
              <td>{{ room.capacity }} guests</td>
            </tr>
            <tr>
              <th>Status</th>
              <td>
                {% if room.isAvailable %}
                  <span class="badge bg-success">Available</span>
                {% else %}
                  <span class="badge bg-secondary">Maintenance</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <th>Image Path</th>
              <td><code>{{ room.imagePath ?? 'None set' }}</code></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a href="{{ path('app_room_edit', {'id': room.id}) }}" class="btn btn-sm btn-outline-success">
          <i class="bi bi-pencil-square"></i> Edit Room
        </a>

        {{ include('room/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}