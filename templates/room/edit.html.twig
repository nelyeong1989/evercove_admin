{% extends 'base.html.twig' %}

{% block title %}Edit {{ room.name }} — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .form-wrapper { max-width: 620px; margin: 0 auto; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Edit Room #{{ room.id }}</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Update room details, night rate, image path, or availability.</p>
      </div>
      <a href="{{ path('app_room_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      {{ include('room/_form.html.twig', {'button_label': 'Update Room'}) }}

      <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted" style="font-size: 0.82rem;">Danger Zone: Permanently remove this room.</span>
        {{ include('room/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}