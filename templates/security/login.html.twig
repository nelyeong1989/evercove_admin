{% extends 'base.html.twig' %}

{% block title %}Sign In — Evercove Admin{% endblock %}

{% block stylesheets %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body {
    background-color: #f4f6f8;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  .auth-card {
    width: 100%;
    max-width: 420px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    border: 1px solid rgba(188, 148, 86, 0.2);
    overflow: hidden;
  }
  .auth-header {
    background: #274d3a;
    color: #f2e1d1;
    padding: 2rem 1.5rem;
    text-align: center;
  }
  .auth-header h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.5px;
  }
  .auth-header p {
    margin-top: 0.5rem;
    margin-bottom: 0;
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .auth-body {
    padding: 2rem 1.75rem;
  }
  .btn-gold {
    background: #bc9456;
    color: #ffffff;
    font-weight: 700;
    border: none;
    width: 100%;
    padding: 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .btn-gold:hover {
    background: #a17d45;
    color: #ffffff;
  }
  .auth-footer {
    text-align: center;
    margin-top: 1.25rem;
    font-size: 0.85rem;
  }
  .auth-footer a {
    color: #274d3a;
    font-weight: 600;
    text-decoration: none;
  }
  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>
{% endblock %}

{% block body %}
<div class="auth-card">
  <div class="auth-header">
    <h3>Evercove Admin</h3>
    <p>Sign in to access your management dashboard</p>
  </div>
  <div class="auth-body">
    {% if error %}
      <div class="alert alert-danger p-2 mb-3" style="font-size: 0.85rem;">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    {% if app.user %}
      <div class="alert alert-info p-2 mb-3" style="font-size: 0.85rem;">
        Logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
      </div>
    {% endif %}

    <form method="post">
      <div class="mb-3">
        <label for="inputEmail" class="form-label text-secondary fw-semibold mb-1" style="font-size: 0.85rem;">Email Address</label>
        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="admin@evercove.com">
      </div>

      <div class="mb-3">
        <label for="inputPassword" class="form-label text-secondary fw-semibold mb-1" style="font-size: 0.85rem;">Password</label>
        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="••••••••">
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
        <label class="form-check-label text-secondary" for="remember_me" style="font-size: 0.85rem;">
          Remember me
        </label>
      </div>

      <button class="btn btn-gold" type="submit">Sign In</button>
    </form>

    <div class="auth-footer text-muted">
      Need an admin account? <a href="{{ path('app_register') }}">Register here</a>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}