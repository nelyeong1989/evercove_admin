<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Evercove Inn &amp; Suites{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo-1.png') }}">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset('style.css') }}">
        <link rel="stylesheet" href="{{ asset('css/evercove-app.css') }}?v=4">

        {% block stylesheets %}{% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set isStorefront = currentRoute == 'app_home' %}
    {% set isAuthPage = currentRoute == 'app_login' %}

    <body class="{{ isStorefront ? 'evercove-storefront-shell' : (isAuthPage ? 'evercove-auth-shell' : 'evercove-admin-shell') }}">
        {# Global Evercove Toast Alerts #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="system-alert {{ label == 'error' or label == 'danger' ? 'alert-error' : 'alert-success' }}" id="alert-banner">
                    <span>{{ message }}</span>
                    <button type="button" class="alert-close" onclick="this.parentElement.remove()">&times;</button>
                </div>
            {% endfor %}
        {% endfor %}

        {% if isStorefront or isAuthPage %}
            <main class="evercove-main-content">
                {% block body %}{% endblock %}
            </main>
        {% else %}
            {% if app.user %}
                {% include 'partials/_sidebar.html.twig' %}
            {% endif %}

            <div class="evercove-workspace">
                <main class="evercove-main-content">
                    {{ block('body') }}
                </main>

                {% if app.user %}
                    {% include 'partials/_footer.html.twig' %}
                {% endif %}
            </div>
        {% endif %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            window.addEventListener('DOMContentLoaded', () => {
                const alert = document.getElementById('alert-banner');
                if (alert) {
                    setTimeout(() => { alert.style.display = 'none'; }, 4000);
                }
            });
        </script>
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </body>
</html>