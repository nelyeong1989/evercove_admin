{% set currentRoute = app.request.attributes.get('_route') %}

{# Mobile Top Header (< 992px) #}
<div class="evercove-mobile-bar d-lg-none">
  <a href="{{ is_granted('ROLE_ADMIN') ? path('app_dashboard') : path('app_reservation_index') }}" class="d-flex align-items-center text-decoration-none">
    <img src="{{ asset('images/logo-2.png') }}" alt="Evercove" style="height: 34px; width: auto;">
  </a>
  <button type="button" class="btn btn-sm" style="background: #bc9456; color: #fff; font-weight: 600;"
          onclick="document.body.classList.toggle('sidebar-open')">
    <i class="bi bi-list fs-5"></i> Menu
  </button>
</div>

{# Mobile Backdrop Overlay #}
<div class="evercove-sidebar-backdrop" onclick="document.body.classList.remove('sidebar-open')"></div>

{# Fixed Left Sidebar #}
<aside class="evercove-sidebar" id="evercoveSidebar">
  <div class="sidebar-brand">
    <a href="{{ is_granted('ROLE_ADMIN') ? path('app_dashboard') : path('app_reservation_index') }}" class="d-flex align-items-center gap-2 text-decoration-none">
      <img src="{{ asset('images/logo-2.png') }}" alt="Evercove Inn & Suites" style="height: 40px; width: auto;">
    </a>
    <button type="button" class="btn-close btn-close-white d-lg-none" aria-label="Close"
            onclick="document.body.classList.remove('sidebar-open')"></button>
  </div>

  {% if app.user %}
    <div class="sidebar-user-card">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <strong class="text-truncate" style="color: #f2e1d1; font-size: 0.92rem;">
          {{ app.user.fullName ?: app.user.username }}
        </strong>
        <span class="badge {{ is_granted('ROLE_ADMIN') ? 'badge-admin' : 'badge-staff' }}" style="font-size: 0.68rem;">
          {{ is_granted('ROLE_ADMIN') ? 'ADMIN' : 'STAFF' }}
        </span>
      </div>
      <div class="text-truncate" style="color: rgba(242, 225, 209, 0.72); font-size: 0.76rem;">
        {% if app.user.fullName %}@{{ app.user.username }} &bull; {% endif %}{{ app.user.email }}
      </div>
    </div>
  {% endif %}

  <nav class="sidebar-nav">
    {% if is_granted('ROLE_ADMIN') %}
      <div class="sidebar-section-label">Management</div>
      <a href="{{ path('app_dashboard') }}" class="sidebar-link {{ currentRoute == 'app_dashboard' or currentRoute == 'app_dashboard_alt' ? 'active' : '' }}">
        <i class="bi bi-speedometer2"></i>
        <span>Dashboard</span>
      </a>
      <a href="{{ path('app_category_index') }}" class="sidebar-link {{ currentRoute starts with 'app_category' ? 'active' : '' }}">
        <i class="bi bi-tags"></i>
        <span>Room Categories</span>
      </a>
      <a href="{{ path('app_room_index') }}" class="sidebar-link {{ currentRoute starts with 'app_room' ? 'active' : '' }}">
        <i class="bi bi-door-open"></i>
        <span>Room Catalog</span>
      </a>
      <a href="{{ path('app_user_index') }}" class="sidebar-link {{ currentRoute starts with 'app_user' or currentRoute == 'app_register' ? 'active' : '' }}">
        <i class="bi bi-people"></i>
        <span>Staff Accounts</span>
      </a>
    {% endif %}

    {% if is_granted('ROLE_STAFF') %}
      <div class="sidebar-section-label">Operations</div>
      <a href="{{ path('app_reservation_index') }}" class="sidebar-link {{ currentRoute starts with 'app_reservation' ? 'active' : '' }}">
        <i class="bi bi-calendar-check"></i>
        <span>Reservations</span>
      </a>
      <a href="{{ path('app_payment_index') }}" class="sidebar-link {{ currentRoute starts with 'app_payment' ? 'active' : '' }}">
        <i class="bi bi-credit-card"></i>
        <span>Payments</span>
      </a>
    {% endif %}
  </nav>

  <div class="sidebar-footer">
    <a href="{{ path('app_home') }}" class="sidebar-link">
      <i class="bi bi-shop-window"></i>
      <span>View Storefront</span>
    </a>
    <a href="{{ path('app_logout') }}" class="sidebar-link sidebar-logout">
      <i class="bi bi-box-arrow-left"></i>
      <span>Log Out</span>
    </a>
  </div>
</aside>