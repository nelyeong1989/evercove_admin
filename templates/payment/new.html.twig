{% extends 'base.html.twig' %}

{% block title %}Record Payment — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .form-wrapper { max-width: 600px; margin: 0 auto; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="form-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Record Payment</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Log a payment against an existing guest reservation.</p>
      </div>
      <a href="{{ path('app_payment_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      {{ include('payment/_form.html.twig') }}
    </div>
  </div>
</div>
{% endblock %}