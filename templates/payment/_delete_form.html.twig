{% if is_granted('RECORD_DELETE', payment) %}
<form method="post" action="{{ path('app_payment_delete', {'id': payment.id}) }}" class="d-inline"
      onsubmit="return confirm('Are you sure you want to delete payment #{{ payment.id }}?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-trash"></i> Delete
    </button>
</form>
{% endif %}