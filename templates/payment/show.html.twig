{% extends 'base.html.twig' %}

{% block title %}Payment #{{ payment.id }} — Evercove Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .admin-container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .detail-wrapper { max-width: 720px; margin: 0 auto; }
  .detail-table th { width: 34%; color: #274d3a; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; background: transparent; }
  .detail-table td { color: #2d3748; font-size: 0.95rem; }
</style>
{% endblock %}

{% block body %}
<div class="admin-container">
  <div class="detail-wrapper">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 style="color: #274d3a; font-weight: 700; margin: 0;">Payment #{{ payment.id }}</h2>
        <p class="text-muted mb-0" style="font-size: 0.88rem;">Transaction receipt and record ownership details.</p>
      </div>
      <a href="{{ path('app_payment_index') }}" class="btn btn-sm btn-outline-secondary">&larr; Back to List</a>
    </div>

    <div class="evercove-card">
      <div class="table-responsive">
        <table class="table detail-table align-middle mb-0">
          <tbody>
            <tr>
              <th>Payment ID</th>
              <td><strong>#{{ payment.id }}</strong></td>
            </tr>
            <tr>
              <th>Reservation</th>
              <td>
                <a href="{{ path('app_reservation_show', {'id': payment.reservation.id}) }}" class="text-decoration-none">
                  <span class="badge" style="background-color: #f2e1d1; color: #274d3a; font-size: 0.85rem;">
                    Booking #{{ payment.reservation.id }} — {{ payment.reservation.user.username }} ({{ payment.reservation.room.name }})
                  </span>
                </a>
              </td>
            </tr>
            <tr>
              <th>Amount Paid</th>
              <td><strong style="color: #274d3a; font-size: 1.05rem;">₱{{ payment.amount|number_format(2) }}</strong></td>
            </tr>
            <tr>
              <th>Payment Method</th>
              <td>{{ payment.paymentMethod }}</td>
            </tr>
            <tr>
              <th>Status</th>
              <td>
                {% if payment.paymentStatus == 'Paid' %}
                  <span class="badge bg-success">Paid</span>
                {% elseif payment.paymentStatus == 'Pending' %}
                  <span class="badge bg-warning text-dark">Pending</span>
                {% elseif payment.paymentStatus == 'Refunded' %}
                  <span class="badge bg-info text-dark">Refunded</span>
                {% else %}
                  <span class="badge bg-danger">{{ payment.paymentStatus }}</span>
                {% endif %}
              </td>
            </tr>
            <tr>
              <th>Paid At</th>
              <td>{{ payment.paidAt ? payment.paidAt|date('M d, Y h:i A') : '—' }}</td>
            </tr>
            <tr>
              <th>Recorded By (Staff)</th>
              <td>
                {% if payment.createdBy %}
                  <span class="text-muted"><i class="bi bi-person-badge"></i> {{ payment.createdBy.username }}</span>
                {% else %}
                  <span class="text-muted">System</span>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <div class="d-flex gap-2">
          {% if is_granted('RECORD_EDIT', payment) %}
            <a href="{{ path('app_payment_edit', {'id': payment.id}) }}" class="btn btn-sm btn-outline-success">
              <i class="bi bi-pencil-square"></i> Edit Payment
            </a>
          {% else %}
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="You can only edit payments you recorded.">
              <i class="bi bi-lock-fill"></i> Locked (Not Owner)
            </button>
          {% endif %}
        </div>

        {{ include('payment/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}